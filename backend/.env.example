# Copy this to .env for local dev. On Render, set these as actual
# environment variables in the dashboard instead of uploading .env.

# Postgres connection string from Neon (or any Postgres provider)
DATABASE_URL=postgresql://user:password@host/dbname

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Used only by seed.py, to create the first super admin
NBSS_ADMIN_EMAIL=admin@nbss.org
NBSS_ADMIN_PASSWORD=changeme123
NBSS_ADMIN_NAME=National Chairman
